NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# MongoDB Atlas (server only). Use a least-privilege database user and Atlas IP controls.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ax7mov

# Vercel Blob. New project connections use OIDC; run `vercel env pull` locally.
# Never expose any of these values with a NEXT_PUBLIC_ prefix.
VERCEL_OIDC_TOKEN=
BLOB_STORE_ID=

# Optional legacy alternative to the OIDC pair above.
BLOB_READ_WRITE_TOKEN=

# Single-admin bootstrap credentials. These are used only to create/recover the
# primary MongoDB admin user; the first login must replace the temporary password.
ADMIN_EMAIL=admin@example.com
ADMIN_TEMP_PASSWORD=Admin@123456

# Generate at least 64 random bytes: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_BYTES
ADMIN_SESSION_HOURS=8

# Exact deployed origin, without a trailing slash. Use http://localhost:3000 locally.
SITE_ORIGIN=http://localhost:3000
